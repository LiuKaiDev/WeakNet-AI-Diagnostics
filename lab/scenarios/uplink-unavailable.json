  "required_capabilities": ["linux", "ip", "tc", "netns", "cap_net_admin", "session_dbus", "weaknetd", "weaknetctl", "python_venv", "dbus_next"],
  "workload": "none",
  "fault": "remove-default-route",
  "fault_options": {},
  "warmup_seconds": 3,
  "observation_timeout_seconds": 12,
  "expected_incidents": ["UplinkUnavailable"],
  "expected_hypothesis_types": ["UplinkAvailabilityProblem"],
  "allowed_hypothesis_types": ["UplinkAvailabilityProblem"],
  "allowed_statuses": ["Degraded"],
  "recovery": true,
  "recovery_timeout_seconds": 12,
  "require_nonhealthy_status": true
}
